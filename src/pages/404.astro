---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout title="404 - Không tìm thấy trang">
  <main class="flex min-h-screen flex-col items-center justify-center p-6 text-center">
    <span class="text-6xl font-black text-indigo-500">404</span>
    <h1 class="mt-4 text-2xl font-bold tracking-tight text-white sm:text-3xl">
      Trang không tồn tại
    </h1>
    <p class="mt-2 text-sm text-slate-400">
      Đường dẫn bạn yêu cầu không tìm thấy hoặc đã được di chuyển.
    </p>
    <div class="mt-6">
      <a href="/">
        <Button variant="primary">Quay lại trang chủ</Button>
      </a>
    </div>
  </main>
</BaseLayout>
