---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import ExampleWidget from '@/features/example/components/ExampleWidget.astro';
import { getCollection } from 'astro:content';
import { Rocket, Activity } from '@lucide/astro';

const posts = await getCollection('blog');
---

<BaseLayout title="Astro Template - Production Ready">
  <main class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <header class="text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-xs font-semibold text-indigo-400">
        <Rocket class="size-3.5" />
        <span>Production-ready</span>
        <span class="text-slate-500">•</span>
        <span>Astro 5+ & Tailwind v4</span>
      </div>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Astro Template
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-base text-slate-400 sm:text-lg">
        Khung kiến trúc khởi đầu dự án Astro tối ưu cho phát triển cá nhân (Solo) lẫn làm việc nhóm
        (Team).
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/api/health" target="_blank" rel="noopener noreferrer">
          <Button variant="primary" class="gap-2">
            <Activity class="size-4" />
            <span>Healthcheck API</span>
          </Button>
        </a>
        <a href="https://docs.astro.build" target="_blank" rel="noopener noreferrer">
          <Button variant="secondary">Tài liệu Astro</Button>
        </a>
      </div>
    </header>

    <section class="mt-16 grid gap-6 md:grid-cols-2">
      <ExampleWidget />

      <Card>
        <div class="mb-4 flex items-center justify-between">
          <h3 class="text-lg font-semibold text-white">Content Layer API</h3>
          <span class="rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs font-medium text-emerald-400">
            src/content.config.ts
          </span>
        </div>
        <div class="space-y-4">
          {posts.map((post) => (
            <article class="rounded-lg border border-slate-800 bg-slate-950/40 p-4">
              <h4 class="text-base font-medium text-white">{post.data.title}</h4>
              <p class="mt-1 text-xs text-slate-400">{post.data.description}</p>
              <div class="mt-2 text-xs font-mono text-slate-500">
                {post.data.pubDate.toLocaleDateString('vi-VN')}
              </div>
            </article>
          ))}
        </div>
      </Card>
    </section>
  </main>
</BaseLayout>
